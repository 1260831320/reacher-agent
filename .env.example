# Keep the real API key in an untracked file outside this repository.
RAG_ENV_FILE=/absolute/path/to/private/model.env

# Quality-first route: Bailian US Anthropic-compatible endpoint, domestic Qwen model.
BAILIAN_API_URL=https://dashscope-us.aliyuncs.com/apps/anthropic/v1/messages
BAILIAN_PROTOCOL=anthropic
BAILIAN_MODEL=qwen3.7-max

ARXIV_MAX_RESULTS=100
ARXIV_LOOKBACK_DAYS=4
SHORTLIST_SIZE=12
DAILY_TOP_COUNT=5
PDF_EVIDENCE_COUNT=3
PDF_MAX_BYTES=25000000
PDF_MAX_CHARS=55000
EXTERNAL_SOURCE_TIMEOUT_MS=12000

# Optional API tokens. Public endpoints work without them but have lower limits.
GITHUB_TOKEN=
HF_TOKEN=

# Optional Feishu group/private delivery (chat_id takes precedence over open_id).
FEISHU_RESEARCH_ENABLED=0
FEISHU_RESEARCH_APP_ID=
FEISHU_RESEARCH_APP_SECRET=
FEISHU_RESEARCH_CHAT_ID=
FEISHU_RESEARCH_RECIPIENT_OPEN_ID=
# Set to 0 to mute the alert that fires when an empty digest is blocked.
FEISHU_ALERT_ON_EMPTY=1

# Local-only defaults; deployment creates random values in a restricted server env file.
POSTGRES_DB=ai_research
POSTGRES_USER=research_agent
POSTGRES_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me
RESEARCH_AGENT_PORT=8787
TZ=Asia/Tokyo
