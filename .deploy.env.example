# Copy to .deploy.env. This file is gitignored; never commit real values.
DEPLOY_HOST=deploy-user@example-host
DEPLOY_KEY=/absolute/path/to/private/ssh-key
REMOTE_SOURCE_ENV=/absolute/path/to/private/server.env
FEISHU_RESEARCH_CHAT_ID=oc_replace_with_target_chat_id

# Optional deployment controls.
INSTALL_ROOT=/absolute/server/path/to/ai-research-agent
RUN_SMOKE=1
